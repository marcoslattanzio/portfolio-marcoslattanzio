# Credenciales de /admin. Las lee proxy.js en el servidor; nunca llegan al
# navegador. Copia este archivo como .env.local para trabajar en local, y en
# producción configúralas en Vercel → Settings → Environment Variables.
#
# Si faltan en producción, /admin devuelve 503 en vez de quedarse abierto.

ADMIN_USER=marco
ADMIN_PASSWORD=cambia-esto-por-una-contrasena-larga
